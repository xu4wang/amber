#!/usr/bin/env python3
"""Submit an Amber draft from any fleet machine (no credentials; access is by IP allowlist).

usage: amber-submit draft.json [--label NAME]
       AMBER_URL overrides the endpoint (default http://amber.dev-beta.ksherpay.com/v1/drafts)
"""
import json, os, sys, urllib.request, urllib.error

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip()); return 2
    path, label = argv[0], None
    if "--label" in argv:
        i = argv.index("--label"); label = argv[i + 1] if i + 1 < len(argv) else None
    draft = json.load(open(path, encoding="utf-8"))
    if label:
        draft["submittedBy"] = label
    url = os.environ.get("AMBER_URL", "http://amber.dev-beta.ksherpay.com/v1/drafts")
    req = urllib.request.Request(url, data=json.dumps(draft, ensure_ascii=False).encode("utf-8"),
                                 headers={"content-type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            print(r.read().decode("utf-8")); return 0
    except urllib.error.HTTPError as e:
        print(e.read().decode("utf-8"), file=sys.stderr); return 1

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
