#!/usr/bin/env python3
"""amber — command line for agents to use Amber (Python 3 standard library only).

Commands that need no one's identity run directly. Anything else (the command calls a service as a
person, needs confirmation, or creates a schedule) makes Amber post a confirmation card in the chat;
the person who clicks it is who it runs as. Then use `amber wait <request>` to learn the outcome; the output itself stays on the Feishu card.

usage:
  amber list                                   commands usable in this chat
  amber show <command>                         parameters and how `run` behaves
  amber run <command> [name=value ...]         run (or ask for confirmation)
  amber wait <request> [--timeout SECONDS]     wait for a confirmation request (default 600 s)
  amber schedule add <command> --at "每天 09:00" [--tz <时区>] [name=value ...]
                                               (also: 工作日 09:00, 每周一 09:00, 每 2 小时, 每 15 分钟; min 5 minutes)
  amber schedule list
  amber schedule pause <id>                    stops it at once
  amber schedule resume <id> | delete <id>     the creator confirms on a card
  amber submit draft.json                      submit a new command for review (same name = new version);
                                               the file may leave out chatId/claimer (this chat and --user are
                                               used) and keep its code in a file ("codeFile": "app.py"), e.g.
                                               amber submit samples/weather/app.json --user me@example.com
  amber retire <command>                       take a command offline; its creator or an admin confirms on a card
  amber global <command> | local <command>     make a command usable everywhere / only where it was made;
                                               an admin confirms on a card
  amber page publish <dir> [--name NAME]       publish a page app (a directory with index.html) for --user;
                                               a new page, or new apps in its amber.json, needs their confirmation
  amber trigger add --on EVENT [--app NAME] [--to me|here] [--mention BOT[,BOT]] [--name NAME]
                                               when EVENT happens in Amber, notify --user privately, or in this
                                               chat/topic (--to here), @-ing bots there; --user confirms on a card.
                                               events: app.review_started app.approved app.rejected app.retired
                                               run.failed run.output schedule.paused executor.offline executor.online
                                               page.published page.apps_changed
  amber trigger list                           --user's triggers
  amber trigger pause <id>                     stops it at once (resume or delete it on the website)
  amber secret get <command> <NAME> --out FILE [--force] [--timeout SECONDS]
                                               read one secret of --user's app into FILE (mode 600); --user is
                                               the app's creator and allows it on a card in their private chat,
                                               every time. The value is never printed. Waits up to 300 s.
  amber envs [--mine]                          approved run environments to name in script.env ("executor/env");
                                               --mine: only those exported from this bot ($BOTMUX_LARK_APP_ID)
  amber info                                   the Amber service this machine uses, and its website
  amber config set-url <url>                   set the Amber service address for this machine

context options (defaults come from botmux environment variables):
  --chat oc_...        chat id                ($BOTMUX_CHAT_ID)
  --chat-type TYPE     group | p2p            ($BOTMUX_CHAT_TYPE)
  --user EMAIL         the person you are working for; only they can click the card.
                       Required in private chats.
  --reply-to om_...    post cards in this topic ($BOTMUX_ROOT_MESSAGE_ID when it is a message)
  --label NAME         your agent name        ($AMBER_LABEL)
  --json               print raw JSON

exit codes: 0 done, 1 error, 2 usage, 3 still waiting for a person
service address: $AMBER_URL, else ~/.config/amber-client.json {"url": "..."} (written by
`amber config set-url`). Each installation sets its own; nothing is built in.
"""
import base64, hashlib, hmac, json, os, sys, time, urllib.request, urllib.error

CONFIG = os.path.expanduser("~/.config/amber-client.json")


def service_url():
    url = os.environ.get("AMBER_URL", "").strip()
    if not url:
        try:
            with open(CONFIG, encoding="utf-8") as f:
                url = str(json.load(f).get("url", "")).strip()
        except (OSError, ValueError):
            url = ""
    if not url:
        raise SystemExit("amber: 还没配置 Amber 服务地址。请向部署 Amber 的人要地址，然后运行：amber config set-url http://<地址>"
                         "（或设置环境变量 AMBER_URL）")
    url = url.rstrip("/")
    return url[: -len("/v1/drafts")] if url.endswith("/v1/drafts") else url


BASE = None


class Usage(Exception):
    pass


def call(method, path, body=None, timeout=150):
    global BASE
    BASE = BASE or service_url()
    data = json.dumps(body, ensure_ascii=False).encode("utf-8") if body is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method, headers={"content-type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        try:
            return json.loads(raw)
        except ValueError:
            return {"ok": False, "error": "http_%d" % e.code, "message": raw[:500]}
    except urllib.error.URLError as e:
        return {"ok": False, "error": "unreachable", "message": "连不上 Amber（%s）：%s" % (BASE, e.reason)}


def parse(argv):
    opts, pos, args = {}, [], {}
    flags = {"--chat", "--chat-type", "--user", "--reply-to", "--label", "--at", "--tz", "--timeout", "--name", "--on", "--app", "--to", "--mention", "--out"}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            opts["json"] = True
        elif a == "--mine":
            opts["mine"] = True
        elif a == "--force":
            opts["force"] = True
        elif a in ("-h", "--help"):
            raise Usage()
        elif a in flags:
            if i + 1 >= len(argv):
                raise Usage()
            opts[a[2:]] = argv[i + 1]
            i += 1
        elif a.startswith("--"):
            raise Usage()
        elif "=" in a and pos:
            k, v = a.split("=", 1)
            args[k] = v
        else:
            pos.append(a)
        i += 1
    return opts, pos, args


# --- amber secret get: the value comes sealed to a key pair made for this one request (src/secret-box.ts) ---
_P = 2 ** 255 - 19


def _x25519(k, u):
    """RFC 7748 scalar multiplication."""
    k = bytearray(k)
    k[0] &= 248; k[31] &= 127; k[31] |= 64
    k = int.from_bytes(k, "little")
    x1 = int.from_bytes(u, "little") & ((1 << 255) - 1)
    x2, z2, x3, z3, swap = 1, 0, x1, 1, 0
    for t in range(254, -1, -1):
        kt = (k >> t) & 1
        swap ^= kt
        if swap:
            x2, x3, z2, z3 = x3, x2, z3, z2
        swap = kt
        a, b = (x2 + z2) % _P, (x2 - z2) % _P
        aa, bb = a * a % _P, b * b % _P
        e = (aa - bb) % _P
        c, d = (x3 + z3) % _P, (x3 - z3) % _P
        da, cb = d * a % _P, c * b % _P
        x3, z3 = (da + cb) ** 2 % _P, x1 * (da - cb) ** 2 % _P
        x2, z2 = aa * bb % _P, e * (aa + 121665 * e) % _P
    if swap:
        x2, z2 = x3, z3
    return (x2 * pow(z2, _P - 2, _P) % _P).to_bytes(32, "little")


def _hkdf(ikm, salt, info, n):
    prk = hmac.new(salt, ikm, hashlib.sha256).digest()
    out, t, i = b"", b"", 1
    while len(out) < n:
        t = hmac.new(prk, t + info + bytes([i]), hashlib.sha256).digest()
        out += t
        i += 1
    return out[:n]


def open_box(priv, box):
    epk, nonce, ct, tag = (base64.b64decode(box[k]) for k in ("epk", "nonce", "ct", "tag"))
    keys = _hkdf(_x25519(priv, epk), nonce, b"amber-secret-read/1", 64)
    enc, mac = keys[:32], keys[32:]
    if not hmac.compare_digest(hmac.new(mac, epk + nonce + ct, hashlib.sha256).digest(), tag):
        raise SystemExit("amber: 收到的密钥校验失败（被改动过或不是给这次请求的），没有写入")
    ks = b""
    i = 0
    while len(ks) < len(ct):
        ks += hmac.new(enc, nonce + i.to_bytes(4, "big"), hashlib.sha256).digest()
        i += 1
    return bytes(x ^ y for x, y in zip(ct, ks))


def secret_get(opts, pos, ctx):
    if len(pos) < 4 or pos[1] != "get" or not opts.get("out"):
        raise Usage()
    if not ctx.get("user"):
        raise SystemExit("amber: 要用 --user 写应用创建人的邮箱：确认卡发给他")
    path = os.path.abspath(opts["out"])
    if os.path.exists(path) and not opts.get("force"):
        raise SystemExit("amber: %s 已存在；要覆盖请加 --force" % path)
    priv = os.urandom(32)
    pub = base64.b64encode(_x25519(priv, (9).to_bytes(32, "little"))).decode()
    r = call("POST", "/v1/secrets/read", dict(ctx, command=pos[2], secret=pos[3], publicKey=pub))
    if not r.get("ok"):
        return out(r, opts)
    rid = r["requestId"]
    print("已私聊 %s 发出确认卡（请求 %s），等对方允许……" % (ctx["user"], rid), file=sys.stderr)
    deadline = time.time() + float(opts.get("timeout") or 300)
    while True:
        r = call("GET", "/v1/requests/%s?wait=%d" % (rid, max(1, min(50, int(deadline - time.time())))), timeout=70)
        if not r.get("ok") or r.get("status") not in ("awaiting", "running") or time.time() >= deadline:
            break
    if not r.get("ok"):
        return out(r, opts)
    if r.get("status") != "done":
        st = r.get("status")
        print({"awaiting": "等不到确认（超时）。私钥只在这个进程里，请重新运行这条命令。", "canceled": "对方拒绝了。",
               "expired": "请求已过期（10 分钟）。"}.get(st, "失败：%s" % (r.get("error") or st)), file=sys.stderr)
        return 3 if st == "awaiting" else 1
    f = call("POST", "/v1/secrets/fetch", {"requestId": rid})
    if not f.get("ok"):
        return out(f, opts)
    value = open_box(priv, f["box"])
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, ".%s.%d.tmp" % (os.path.basename(path), os.getpid()))
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(value)
        if opts.get("force"):
            os.replace(tmp, path)
        else:
            try:
                os.link(tmp, path)   # never replaces a file that appeared meanwhile
            except FileExistsError:
                raise SystemExit("amber: %s 已存在；要覆盖请加 --force（这次取到的值已丢弃，需要时重新发起）" % path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    print("已写入 %s（%d 字节，权限 600）。值没有打印。" % (path, len(value)))
    return 0


def context(opts):
    root = os.environ.get("BOTMUX_ROOT_MESSAGE_ID", "")
    reply_to = opts.get("reply-to") or (root if root.startswith("om_") else None)
    ctx = {
        "chatId": opts.get("chat") or os.environ.get("BOTMUX_CHAT_ID"),
        "chatType": opts.get("chat-type") or os.environ.get("BOTMUX_CHAT_TYPE") or "group",
        "label": opts.get("label") or os.environ.get("AMBER_LABEL"),
    }
    if opts.get("user"):
        ctx["user"] = opts["user"]
    if reply_to:
        ctx["replyTo"], ctx["inThread"] = reply_to, True
    if not ctx["chatId"]:
        raise SystemExit("amber: 不知道是哪个会话：用 --chat 指定，或在 botmux 会话里运行（$BOTMUX_CHAT_ID）")
    return ctx


def out(r, opts, text=None):
    if opts.get("json") or not r.get("ok"):
        print(json.dumps(r, ensure_ascii=False, indent=2))
    elif text is not None:
        print(text)
    if not r.get("ok"):
        return 1
    return 3 if r.get("status") == "awaiting" else 0


def fmt_params(c):
    lines = []
    for p in c.get("params", []):
        extra = []
        if p.get("required"):
            extra.append("必填")
        if p.get("default") is not None:
            extra.append("默认 %s" % p["default"])
        if p.get("defaultFrom") == "caller.city":
            extra.append("不填用执行人的办公城市")
        lines.append("  %s=<%s>  %s %s" % (p["name"], p.get("type"), p.get("label") or "", "（%s）" % "，".join(extra) if extra else ""))
    return "\n".join(lines) or "  （无参数）"


def main(argv):
    opts, pos, args = parse(argv)
    if not pos:
        raise Usage()
    cmd = pos[0]
    if cmd == "config":
        if len(pos) < 3 or pos[1] != "set-url" or not pos[2].startswith(("http://", "https://")):
            raise Usage()
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w", encoding="utf-8") as f:
            json.dump({"url": pos[2].rstrip("/")}, f)
        print("已设置 Amber 服务地址：%s" % pos[2].rstrip("/"))
        return 0
    if cmd == "info":
        r = call("GET", "/v1/info")
        return out(r, opts, "Amber 服务：%s\n网站：%s\n本机名称：%s" % (BASE, r.get("webUrl"), r.get("machine")))
    if cmd == "envs":
        r = call("GET", "/v1/envs")
        if not r.get("ok"):
            return out(r, opts, "")
        app = os.environ.get("BOTMUX_LARK_APP_ID", "")
        mine = "mine" in opts
        if mine and not app:
            print("amber: 没有 $BOTMUX_LARK_APP_ID，判断不了哪个是自己的环境；去掉 --mine 看全部", file=sys.stderr)
            return 2
        rows = []
        for ex in r.get("executors") or []:
            for e in ex.get("envs") or []:
                src = e.get("source") or ""
                if mine and not (src == "botmux:" + app or src.startswith("botmux:%s（" % app)):
                    continue
                rows.append((e["ref"], "在线" if ex.get("online") else "离线", src or "-", e.get("workdir", ""), "自己的" if app and (src == "botmux:" + app or src.startswith("botmux:%s（" % app)) else ""))
        if "json" in opts:
            print(json.dumps(r, ensure_ascii=False, indent=2))
            return 0
        if not rows:
            print("没有找到%s运行环境。需要访问本机数据时，请用户找管理员为你登记一个（见文档「执行端」）。" % ("属于你的" if mine else "已批准的"))
            return 0
        print("草稿里写 \"env\": \"<下面第一列>\"；能访问的数据由环境决定，草稿不写路径。\n")
        for ref, st, src, wd, own in rows:
            print("%s\t%s\t来源 %s\tWORKDIR %s%s" % (ref, st, src, wd, "\t← 你自己的环境" if own else ""))
        return 0
    if cmd == "submit":
        if len(pos) < 2:
            raise Usage()
        draft = json.load(open(pos[1], encoding="utf-8"))
        # The code may live in a file next to the definition (samples/*/app.json: "codeFile": "app.py").
        sc = draft.get("script") or {}
        if "codeFile" in sc:
            with open(os.path.join(os.path.dirname(os.path.abspath(pos[1])), sc.pop("codeFile")), encoding="utf-8") as f:
                sc["code"] = f.read()
        # Where and for whom, when the file does not say: this conversation and --user (as for every other command).
        if not draft.get("chatId"):
            c = context(opts)
            draft["chatId"], draft["chatType"] = c["chatId"], c["chatType"]
            if c.get("replyTo"):
                draft.setdefault("originMessageId", c["replyTo"])
                draft.setdefault("inThread", True)
        if not draft.get("claimer") and opts.get("user"):
            draft["claimer"] = opts["user"]
        label = opts.get("label") or os.environ.get("AMBER_LABEL")
        if label:
            draft["submittedBy"] = label
        r = call("POST", "/v1/drafts", draft)
        return out(r, opts, "已提交草稿 %s，Amber 已发出认领卡。" % r.get("id"))
    if cmd == "wait":
        if len(pos) < 2:
            raise Usage()
        deadline = time.time() + float(opts.get("timeout") or 600)
        while True:
            r = call("GET", "/v1/requests/%s?wait=%d" % (pos[1], max(1, min(50, int(deadline - time.time())))), timeout=70)
            if not r.get("ok") or r.get("status") not in ("awaiting", "running") or time.time() >= deadline:
                break
        if not r.get("ok"):
            return out(r, opts)
        st = r.get("status")
        if st in ("awaiting", "running"):
            return out(r, opts, "还在等（%s）。稍后再运行 amber wait %s。" % ("等人点确认" if st == "awaiting" else "执行中", pos[1]))
        if st == "done" and r.get("kind") == "run":
            return out(r, opts, "已执行（以点确认的人的身份）。结果只显示在飞书的确认卡片上（完整内容在 Amber 网站），不会返回给 agent。")
        if st == "done":
            done = {"retire": "应用已下线。", "scope_global": "已设为全局应用。", "scope_local": "已改回只在创建处可用。",
                    "schedule_resume": "定时任务已恢复。", "schedule_delete": "定时任务已删除。"}.get(r.get("kind"))
            return out(r, opts, done or "已完成（%s）%s" % (r.get("kind"), "，定时任务 %s" % r["scheduleId"] if r.get("scheduleId") else ""))
        msg = {"canceled": "对方取消了。", "expired": "请求已过期（24 小时没人点）。"}.get(st, "失败：%s" % (r.get("error") or "详情见飞书卡片"))
        print(json.dumps(r, ensure_ascii=False, indent=2) if opts.get("json") else msg)
        return 1
    ctx = context(opts)
    if cmd == "secret":
        return secret_get(opts, pos, ctx)
    if cmd == "page":
        if len(pos) < 3 or pos[1] != "publish":
            raise Usage()
        root = pos[2]
        if not os.path.isdir(root):
            raise SystemExit("不是目录：%s" % root)
        name = opts.get("name") or os.path.basename(os.path.abspath(root)).lower()
        files, total = [], 0
        for d, dirs, names in os.walk(root):
            dirs[:] = sorted(x for x in dirs if not x.startswith(".") and x != "node_modules")
            for n in sorted(names):
                if n.startswith("."):
                    continue
                full = os.path.join(d, n)
                data = open(full, "rb").read()
                total += len(data)
                files.append({"path": os.path.relpath(full, root).replace(os.sep, "/"), "data": base64.b64encode(data).decode()})
        if total > 10 * 1024 * 1024:
            raise SystemExit("页面目录超过 10MB")
        r = call("POST", "/v1/pages", dict(ctx, name=name, files=files), timeout=120)
        if not r.get("ok"):
            return out(r, opts)
        return out(r, opts, r.get("message") or r.get("status"))
    if cmd == "list":
        r = call("POST", "/v1/commands/list", ctx)
        lines = ["%s%s  %s%s" % (c["name"], "（需确认卡片）" if c["run"] == "confirm_card" else "", c.get("description") or "",
                                  "  [可定时]" if c["options"].get("schedulable") else "") for c in r.get("commands", [])]
        return out(r, opts, "\n".join(lines) or "这里还没有可用的应用。")
    if cmd == "show":
        if len(pos) < 2:
            raise Usage()
        r = call("POST", "/v1/commands/show", dict(ctx, command=pos[1]))
        c = r.get("command") or {}
        how = "直接执行，结果返回给你" if c.get("run") == "direct" else "需要人在飞书确认卡片上点一下（以点击人的身份执行）"
        sec = ""
        if c.get("secrets"):
            miss = c.get("secretsMissing") or []
            sec = "\n密钥：%s%s" % ("、".join(c["secrets"]), "（还没设置：%s，请创建人私聊 Amber 发「设置密钥 %s」）" % ("、".join(miss), c.get("name")) if miss else "（已设置）")
        return out(r, opts, "%s（%s）\n%s\n参数：\n%s\n执行方式：%s\n允许定时：%s%s" % (
            c.get("name"), c.get("id"), c.get("description") or "", fmt_params(c), how, "是" if c.get("options", {}).get("schedulable") else "否", sec))
    if cmd == "run":
        if len(pos) < 2:
            raise Usage()
        # A direct run waits for the result; runs may take up to the admin's maximum (at most 30 minutes).
        r = call("POST", "/v1/runs", dict(ctx, command=pos[1], args=args), timeout=1900)
        if r.get("mode") == "direct":
            if r.get("status") != "ok":
                r["ok"] = False
            return out(r, opts, r.get("markdown") or "（没有输出）")
        return out(r, opts, "%s\nrequest: %s" % (r.get("message"), r.get("requestId")))
    if cmd in ("retire", "global", "local"):
        if len(pos) < 2:
            raise Usage()
        if cmd == "retire":
            r = call("POST", "/v1/commands/retire", dict(ctx, command=pos[1]))
        else:
            r = call("POST", "/v1/commands/scope", dict(ctx, command=pos[1], **{"global": cmd == "global"}))
        return out(r, opts, "%s\nrequest: %s" % (r.get("message"), r.get("requestId")))
    if cmd == "trigger":
        sub = pos[1] if len(pos) > 1 else ""
        if sub == "add":
            if not opts.get("on"):
                raise Usage()
            body = dict(ctx, on=opts["on"], to=opts.get("to") or "me")
            for k in ("app", "name", "mention"):
                if opts.get(k):
                    body[k] = opts[k]
            r = call("POST", "/v1/triggers", body)
            return out(r, opts, "已发出确认卡片，等 %s 点「确认」后生效（触发器 %s）。" % (opts.get("user"), r.get("triggerId")))
        if sub == "list":
            r = call("POST", "/v1/triggers/list", ctx)
            lines = ["%s  %s  %s%s  →  %s%s" % (t["id"], "生效中" if t["status"] == "active" else "已暂停", t["onLabel"], "（%s）" % t["app"] if t.get("app") else "", t["to"],
                                              "" if t["status"] == "active" else "（%s）" % (t.get("pauseReason") or "")) for t in r.get("triggers", [])]
            return out(r, opts, "\n".join(lines) or "还没有触发器。")
        if sub == "pause" and len(pos) > 2:
            r = call("POST", "/v1/triggers/%s/pause" % pos[2], ctx)
            return out(r, opts, "已暂停。恢复或删除请到 Amber 网站「我的触发器」。")
        raise Usage()
    if cmd == "schedule":
        if len(pos) < 2:
            raise Usage()
        sub = pos[1]
        if sub == "add":
            if len(pos) < 3 or not opts.get("at"):
                raise Usage()
            r = call("POST", "/v1/schedules", dict(ctx, command=pos[2], args=args, at=opts["at"], tz=opts.get("tz")))
            return out(r, opts, "%s\n规则：%s；首次运行：%s\nrequest: %s" % (r.get("message"), r.get("rule"), r.get("firstRun"), r.get("requestId")))
        if sub == "list":
            r = call("POST", "/v1/schedules/list", ctx)
            lines = ["%s  %s  %s  %s  %s" % (s["id"], s["command"], s["rule"], "下次 %s" % s["nextRun"] if s["status"] == "active" else "已暂停：%s" % (s.get("pauseReason") or ""), s["last"])
                     for s in r.get("schedules", [])]
            return out(r, opts, "\n".join(lines) or "这里没有定时任务。")
        if sub in ("pause", "resume", "delete"):
            if len(pos) < 3:
                raise Usage()
            r = call("POST", "/v1/schedules/%s/%s" % (pos[2], sub), ctx)
            return out(r, opts, "已暂停。" if sub == "pause" else "%s\nrequest: %s" % (r.get("message"), r.get("requestId")))
    raise Usage()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Usage:
        print(__doc__.strip())
        sys.exit(2)
